with "config/updater_tests_config.gpr";
with "updater.gpr";
project Updater_Tests is
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("check_updater.adb", "stage_updater.adb");
   Swift_SDK := external ("UPDATER_SDK", "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk");

   package Linker is
      for Default_Switches ("Ada") use
        ("-mmacosx-version-min=26.0",
         "-L" & Swift_SDK & "/usr/lib/swift",
         "-Wl,-rpath,/usr/lib/swift",
         "-Wl,-no_implicit_dylibs");
   end Linker;

   package Compiler is
      for Default_Switches ("Ada") use Updater_Tests_Config.Ada_Compiler_Switches & ("-gnatyM120", "-gnata", "-gnatW8");
   end Compiler;
end Updater_Tests;
