with "config/speech_config.gpr";
project Speech is

   for Library_Name use "speech_ada";
   for Library_Version use
     Project'Library_Name & ".so." & Speech_Config.Crate_Version;

   for Languages use ("Ada", "C");
   --  The C is Swift (speech_swift.swift): SpeechAnalyzer can be reached
   --  from Swift alone, so it gives Ada a C interface. Alire has no
   --  configuration for Swift, so it is built as if it were C, by swiftc.
   for Object_Dir use "obj/" & Speech_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   package Naming is
      for Body_Suffix ("C") use ".swift";
   end Naming;

   Swift_SDK := external
     ("SPEECH_SDK", "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk");
   --  Where the Swift libraries to link with are: in the SDK that GCC
   --  links with, unless that is Xcode's, and SPEECH_SDK says so.

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("SPEECH_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   type Proof_Kind is ("yes", "no");
   Proof : Proof_Kind := external ("SPEECH_PROOF", "no");

   case Proof is
      when "yes" =>
         for Source_Dirs use ("src/**", "config/", "variants/eager");
         --  Every slot's task from the start: a proof allows none to be made while the program runs.
      when "no" =>
         for Source_Dirs use ("src/**", "config/", "variants/lazy");
         --  A slot's task is made when the slot is first used.
   end case;

   package Compiler is
      --  Stack probes and canaries are for development and validation builds; a release build leaves them out.
      Stack_Checks := ("-fstack-check", "-fstack-protector-strong");
      case Speech_Config.Build_Profile is
         when "release" => Stack_Checks := ();
         when others => null;
      end case;

      case Proof is
         when "yes" =>
            for Local_Configuration_Pragmas use Project'Project_Dir & "jorvik.adc";
         when "no" =>
            for Local_Configuration_Pragmas use Project'Project_Dir & "speech.adc";
      end case;
      for Default_Switches ("Ada") use Speech_Config.Ada_Compiler_Switches &
        ("-gnatwh",          --  local declarations hiding others
         "-gnatyM120",        --  longest line
         "-gnatVa")          --  validity checks everywhere
        & Stack_Checks & ("-mmacosx-version-min=26.0");
      for Driver ("C") use Project'Project_Dir & "swiftc.sh";
      for Default_Switches ("C") use
        ("-parse-as-library", "-swift-version", "5", "-O",
         "-import-objc-header", Project'Project_Dir & "native/speech_ring.h");
   end Compiler;

   --  Propagated to every project that depends on this one. The plist is
   --  embedded in the program, as a program that is not in a bundle needs
   --  it to ask for the microphone. libBonxieParakeet (Parakeet on Core ML)
   --  and libBonxieGranite (Granite on MLX, with mlx.metallib beside it),
   --  built by native/build.sh, are found by its place here when the program
   --  runs from the tree, or in Frameworks beside the program's folder in a
   --  bundle.
   package Linker is
      for Linker_Options use
        ("-L" & Project'Project_Dir & "native/lib",
         "-lBonxieParakeet",
         "-lBonxieGranite",
         "-Wl,-rpath," & Project'Project_Dir & "native/lib",
         "-Wl,-rpath,@executable_path/../Frameworks",
         "-framework", "Speech",
         "-framework", "AVFoundation",
         "-framework", "Foundation",
         "-mmacosx-version-min=26.0",
         "-L" & Swift_SDK & "/usr/lib/swift",
         "-Wl,-rpath,/usr/lib/swift",
         "-Wl,-no_implicit_dylibs",
         "-Wl,-sectcreate,__TEXT,__info_plist," & Project'Project_Dir
         & "Info.plist");
   end Linker;

   --  Run `gnatprove -P speech.gpr -XSPEECH_PROOF=yes` to analyze the SPARK
   --  units: Speech.Windows, .Words, .Rings, .Gates, .Parakeet,
   --  .Streams and .Jobs.Core. GNATprove checks run-time safety and proves their stated
   --  contracts under their preconditions; it does not prove that contracts
   --  fully specify intended behavior. SPARK-Off bodies and imported native
   --  code are outside the proof. Jorvik lets GNATprove analyze the tasks;
   --  it is a proof configuration, while the program uses full tasking.
   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--timeout=60", "-j0");
   end Prove;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Speech;
