with "config/bonxie_tests_config.gpr";
with "bonxie.gpr";
with "pomarine_goldens.gpr";
with "pomarine_testing.gpr";
with "pomarine_ui.gpr";
with "texts.gpr";
project Bonxie_Tests is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Bonxie_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("golden.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Bonxie_Tests_Config.Ada_Compiler_Switches &
        ("-gnatwn",          --  warnings are not errors: Pomarine's obsolescent entities (-gnatwj) are warned of
                             --  until the code is moved off them, and GNAT cannot exempt just those from -gnatwe
         "-gnatwh",          --  local declarations hiding others
         "-gnatyM120",        --  longest line
         "-gnatVa",          --  validity checks everywhere
         "-fstack-check",    --  detect stack overflow
         "-fstack-protector-strong");
   end Compiler;

   package Linker is
      --  The session keeps its text areas, fixed freehand paths and undo storage
      --  where it is declared: about 72 MB, plus space for calls and temporaries.
      for Default_Switches ("Ada") use ("-Wl,-stack_size,0x6000000");
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Bonxie_Tests;
