with "bonxie.gpr";
project Webshot_Probes is
   for Source_Dirs use ("run/");
   for Object_Dir use "obj/run";
   for Exec_Dir use "bin/";
   for Main use ("page_probe.adb", "links_probe.adb", "fetch_probe.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-gnata", "-gnatwa", "-gnat2022", "-gnato", "-gnatVa");
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use ("-Wl,-stack_size,0x6000000");
   end Linker;
end Webshot_Probes;
