with "config/ebook_tests_config.gpr";
with "ebook.gpr";
project Ebook_Tests is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Ebook_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("ebook_test.adb", "page_view.adb");

   package Compiler is
      for Default_Switches ("Ada") use Ebook_Tests_Config.Ada_Compiler_Switches &
        ("-gnatwh",          --  local declarations hiding others
         "-gnatyM120",        --  longest line
         "-gnatVa",          --  validity checks everywhere
         "-fstack-check",    --  detect stack overflow
         "-fstack-protector-strong");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Ebook_Tests;
