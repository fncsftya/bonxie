with "config/ebook_config.gpr";
with "pomarine_ui.gpr";
project Ebook is

   for Library_Name use "ebook_ada";
   for Library_Version use
     Project'Library_Name & ".so." & Ebook_Config.Crate_Version;

   for Languages use ("Ada", "C");
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Ebook_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("EBOOK_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   --  PDFium is prebuilt: fetch-pdfium.sh puts it in pdfium/, or
   --  PDFIUM_PREFIX says where else it is.
   Pdfium := external ("PDFIUM_PREFIX", Project'Project_Dir & "pdfium");

   package Compiler is
      for Default_Switches ("Ada") use Ebook_Config.Ada_Compiler_Switches &
        ("-gnatwh",          --  local declarations hiding others
         "-gnatyM120",        --  longest line
         "-gnatVa",          --  validity checks everywhere
         "-fstack-check",    --  detect stack overflow
         "-fstack-protector-strong");
      --  Alire's GCC does not find Apple's frameworks: Apple's clang is
      --  used for the C, as for the Objective-C of webshot.
      for Driver ("C") use "/usr/bin/clang";
      for Default_Switches ("C") use
        ("-O2", "-Wall", "-I" & Pdfium & "/include",
         "-Wno-unused-command-line-argument");
   end Compiler;

   --  Propagated to every project that depends on this one.
   package Linker is
      for Linker_Options use
        ("-L" & Pdfium & "/lib", "-lpdfium",
         "-Wl,-rpath," & Pdfium & "/lib",
         "-framework", "ImageIO",
         "-framework", "CoreGraphics",
         "-framework", "CoreFoundation",
         "-framework", "CoreText");
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Ebook;
