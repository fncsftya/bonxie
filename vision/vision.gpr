with "pomarine.gpr";
with "config/vision_config.gpr";
project Vision is

   for Library_Name use "vision_ada";
   for Library_Version use
     Project'Library_Name & ".so." & Vision_Config.Crate_Version;

   for Languages use ("Ada", "C");
   --  The C is Objective-C (vision_ocr.m), for Vision.
   for Source_Dirs use ("src/**", "config/");
   for Object_Dir use "obj/" & Vision_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   package Naming is
      for Body_Suffix ("C") use ".m";
   end Naming;

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("VISION_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      --  Stack probes and canaries are for development and validation builds; a release build leaves them out.
      Stack_Checks := ("-fstack-check", "-fstack-protector-strong");
      case Vision_Config.Build_Profile is
         when "release" => Stack_Checks := ();
         when others => null;
      end case;

      for Default_Switches ("Ada") use Vision_Config.Ada_Compiler_Switches &
        ("-gnatwh",          --  local declarations hiding others
         "-gnatyM120",        --  longest line
         "-gnatVa")          --  validity checks everywhere
        & Stack_Checks;
      --  Alire's GCC does not do Objective-C: Apple's clang does.
      for Driver ("C") use "/usr/bin/clang";
      for Default_Switches ("C") use
        ("-x", "objective-c", "-fobjc-arc", "-O2", "-Wall", "-Wno-unused-command-line-argument");
   end Compiler;

   --  Propagated to every project that depends on this one.
   package Linker is
      for Linker_Options use
        ("-framework", "Vision",
         "-framework", "CoreGraphics",
         "-framework", "ImageIO",
         "-framework", "Foundation");
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Vision;
