with "config/bonxie_config.gpr";
with "pomarine_native.gpr";
with "pomarine_ui.gpr";
with "coretext.gpr";
with "ebook.gpr";
with "mlx.gpr";
with "sdl3.gpr";
with "speech.gpr";
with "texts.gpr";
with "typeset.gpr";
with "vision.gpr";
with "webshot.gpr";
with "yoga.gpr";
with "json.gpr";
project Bonxie is

   for Source_Dirs use ("src/**", "config/");
   for Object_Dir use "obj/" & Bonxie_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("bonxie.adb");

   package Compiler is
      for Default_Switches ("Ada") use Bonxie_Config.Ada_Compiler_Switches &
        ("-gnatwh",          --  local declarations hiding others
         "-gnatyM120",        --  longest line
         "-gnatVa",          --  validity checks everywhere
         "-fstack-check",    --  detect stack overflow
         "-fstack-protector-strong");
   end Compiler;

   package Linker is
      --  The session keeps its items' text areas where it is declared:
      --  more than the usual 8 MB of the main thread's stack.
      for Default_Switches ("Ada") use ("-Wl,-stack_size,0x4000000");
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Bonxie;
