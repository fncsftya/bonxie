package body UI.Themes is

   function Resolve (Item : Theme; Which : Slot) return Color is
     (case Which is
         when Background   => Item.Background,
         when Foreground   => Item.Foreground,
         when Accent       => Item.Accent,
         when Focus        => Item.Focus,
         when Primary      => Item.Primary,
         when Danger       => Item.Danger,
         when Face         => Item.Face,
         when Border       => Item.Border,
         when Shadow       => Item.Shadow,
         when Bar          => Item.Bar,
         when Tint         => Item.Tint,
         when Marker       => Item.Marker,
         when Page         => Item.Page,
         when Rail         => Item.Rail,
         when Dock         => Item.Dock,
         when Dot          => Item.Dot,
         when Muted        => Item.Muted,
         when Closed       => Item.Closed,
         when Hint         => Item.Hint,
         when Rule         => Item.Rule,
         when Hover_Row    => Item.Hover_Row,
         when Drop_Shadow  => Item.Drop_Shadow,
         when Face_Hover   => Item.Face_Hover,
         when Face_Pressed => Item.Face_Pressed,
         when Face_Light   => Item.Face_Light,
         when Face_Shade   => Item.Face_Shade,
         when Face_Edge    => Item.Face_Edge,
         when Primary_Light => Item.Primary_Light,
         when Primary_Shade => Item.Primary_Shade,
         when Danger_Light => Item.Danger_Light,
         when Danger_Shade => Item.Danger_Shade,
         when Primary_Ink  => Item.Primary_Ink,
         when Primary_Mix  => Item.Primary_Mix,
         when Danger_Ink   => Item.Danger_Ink,
         when On_Accent    => Item.On_Accent,
         when Bar_Ink      => Item.Bar_Ink,
         when Scrim        => Item.Scrim,
         when Source_1 => Item.Source_Blue,
         when Source_2 .. Source_8 =>
            Source_Inks (Slot'Pos (Which) - Slot'Pos (Source_1) + 1));

end UI.Themes;
