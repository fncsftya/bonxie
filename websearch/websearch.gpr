with "config/websearch_config.gpr";
project Websearch is

   for Library_Name use "websearch_ada";
   for Library_Version use
     Project'Library_Name & ".so." & Websearch_Config.Crate_Version;

   for Languages use ("Ada", "C");
   --  The C is Objective-C (websearch_wk.m), for WebKit.
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Websearch_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   package Naming is
      for Body_Suffix ("C") use ".m";
   end Naming;

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("WEBSEARCH_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Websearch_Config.Ada_Compiler_Switches &
        ("-gnatwh",          --  local declarations hiding others
         "-gnatyM120",        --  longest line
         "-gnatVa",          --  validity checks everywhere
         "-fstack-check",    --  detect stack overflow
         "-fstack-protector-strong");
      --  Alire's GCC does not do Objective-C: Apple's clang does.
      for Driver ("C") use "/usr/bin/clang";
      for Default_Switches ("C") use
        ("-x", "objective-c", "-fobjc-arc", "-O2", "-Wall", "-Wno-unused-command-line-argument");
   end Compiler;

   --  Propagated to every project that depends on this one.
   package Linker is
      for Linker_Options use
        ("-framework", "WebKit",
         "-framework", "AppKit",
         "-framework", "Foundation");
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Websearch;
