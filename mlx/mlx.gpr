with "config/mlx_config.gpr";
project MLX is

   for Library_Name use "mlx_ada";
   for Library_Version use
     Project'Library_Name & ".so." & MLX_Config.Crate_Version;

   for Languages use ("Ada");
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & MLX_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("MLX_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use MLX_Config.Ada_Compiler_Switches &
        ("-gnatwh",          --  local declarations hiding others
         "-gnatyM120",        --  longest line
         "-gnatVa",          --  validity checks everywhere
         "-fstack-check",    --  detect stack overflow
         "-fstack-protector-strong",
         "-mmacosx-version-min=26.0");
   end Compiler;

   --  Propagated to every project that depends on this one. libBonxieMLX
   --  (built by native/build.sh) is found by its place here when the
   --  program runs from the tree, or in Frameworks beside the program's
   --  folder in a bundle (the rpath for that is Speech's, and a program
   --  may have it only once); mlx.metallib, the GPU's code, is beside it.
   package Linker is
      for Linker_Options use
        ("-L" & Project'Project_Dir & "native/lib",
         "-lBonxieMLX",
         "-Wl,-rpath," & Project'Project_Dir & "native/lib");
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end MLX;
