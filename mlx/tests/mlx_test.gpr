with "../mlx.gpr";
project MLX_Test is
   for Source_Dirs use ("src/");
   for Object_Dir use "obj/";
   for Exec_Dir use "bin/";
   for Main use ("mlx_test.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-gnata", "-gnatwa", "-gnat2022", "-gnato", "-gnatVa");
   end Compiler;
end MLX_Test;
