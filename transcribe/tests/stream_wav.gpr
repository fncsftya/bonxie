with "../transcribe.gpr";
project Stream_Wav is
   for Source_Dirs use ("src/");
   for Object_Dir use "obj/";
   for Exec_Dir use "bin/";
   for Main use ("stream_wav.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-g", "-gnata", "-gnatwa", "-gnat2022", "-gnato");
   end Compiler;
end Stream_Wav;
