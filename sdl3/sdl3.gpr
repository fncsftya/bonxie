with "config/sdl3_config.gpr";
project Sdl3 is

   for Library_Name use "sdl3_ada";
   for Library_Version use Project'Library_Name & ".so." & Sdl3_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Sdl3_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("SDL3_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Sdl3_Config.Ada_Compiler_Switches &
        ("-gnatwh",          --  local declarations hiding others
         "-gnatVa",          --  validity checks everywhere
         "-fstack-check",    --  detect stack overflow
         "-fstack-protector-strong");
   end Compiler;

   --  Propagated to every project that depends on this one.
   package Linker is
      for Linker_Options use ("-lSDL3");
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Sdl3;
