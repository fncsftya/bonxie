with "config/harper_tests_config.gpr";
with "harper.gpr";
project Harper_Tests is
   for Languages use ("Ada", "C");
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("check_harper.adb");
   package Compiler is
      for Default_Switches ("C") use ("-std=c11", "-Wall", "-Wextra", "-Werror");
      for Default_Switches ("Ada") use Harper_Tests_Config.Ada_Compiler_Switches &
        ("-gnatyM120", "-gnata", "-gnatW8");
   end Compiler;
end Harper_Tests;
