with "config/harper_config.gpr";
library project Harper is

   for Library_Name use "harper_ada";
   for Library_Kind use "static";
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj/" & Harper_Config.Build_Profile;
   for Library_Dir use "lib";
   for Create_Missing_Dirs use "True";

   package Compiler is
      --  Stack probes and canaries are for development and validation builds; a release build leaves them out.
      Stack_Checks := ("-fstack-check", "-fstack-protector-strong");
      case Harper_Config.Build_Profile is
         when "release" => Stack_Checks := ();
         when others => null;
      end case;

      for Default_Switches ("Ada") use Harper_Config.Ada_Compiler_Switches &
        ("-gnatwh", "-gnatyM120", "-gnatVa") & Stack_Checks;
   end Compiler;

   package Linker is
      for Linker_Options use
        ("-L" & Project'Project_Dir & "rust/target/release", "-lbonxie_harper",
         "-Wl,-rpath," & Project'Project_Dir & "rust/target/release");
   end Linker;

end Harper;
